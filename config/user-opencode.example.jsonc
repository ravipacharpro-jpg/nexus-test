{
  "$schema": "https://nexus.ai/config.json",
  "provider": {
    "omniroute": {
      "name": "OmniRoute (Free Gateway)",
      "api": "http://localhost:20128/v1",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["OPENAI_API_KEY"],
      "models": {
        "auto": {
          "id": "auto",
          "name": "OmniRoute Auto (free)",
          "reasoning": false,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "auto/coding": {
          "id": "auto/coding",
          "name": "OmniRoute Coding (free)",
          "reasoning": false,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }
    }
  },
  "model": "omniroute/auto",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "mcp": "allow",
    "firebase": "allow"
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details"
    },
    "nexus-local": {
      "path": "~/.local/share/nexus",
      "description": "Contains nexus logs and data"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--isolated"]
    },
    "github": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    },
    "firebase": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "firebase-tools", "mcp"]
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp"
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
